# ============================================================
# BotOS Core — .gitignore
# ============================================================

# ── Build Artifacts ──
build/
out/
*.o
*.d
*.a
*.so
*.so.*
*.dylib
*.obj
*.lib
*.exe

# ── CMake ──
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
Testing/
install_manifest.txt

# ── Kernel / OS Images ──
*.iso
*.img
*.bin
*.elf
*.vmdk
*.vdi
*.vhd
*.qcow2
bzImage
vmlinux

# ── Buildroot ──
buildroot/output/
buildroot/dl/
buildroot/.config
buildroot/.auto.deps
buildroot-engine/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.venv/
venv/
env/

# ── IDE & Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.cproject
.settings/
*.sublime-project
*.sublime-workspace
.vs/

# ── OS-specific ──
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & Debug ──
*.log
core
core.*

# ── Scratch ──
scratch/

# ── User Logs ──
durum.md
durum1.md

# ── Symlinks ──
Program
